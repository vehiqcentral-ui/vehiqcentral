# =============================================================================
# VEHIQ Central — Variables de Entorno
# Copia este archivo a .env.local y rellena los valores.
# Los valores marcados con [REQUERIDO] son necesarios para arrancar.
# =============================================================================

# ------------------------------------------------------------
# Base de datos (PostgreSQL) [REQUERIDO]
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/vehiq?schema=public"

# ------------------------------------------------------------
# NextAuth [REQUERIDO]
# ------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ------------------------------------------------------------
# Redis (rate limiting, colas, caché)
# ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------
# Stripe (facturación y suscripciones)
# ------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASICO="price_..."
STRIPE_PRICE_PROFESIONAL="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="VEHIQ Central <noreply@vehiqcentral.es>"

# ------------------------------------------------------------
# DGT API (Dirección General de Tráfico)
# ------------------------------------------------------------
DGT_API_BASE_URL="https://api.dgt.es/v1"
DGT_API_KEY=""
DGT_CLIENT_ID=""
DGT_CLIENT_SECRET=""

# ------------------------------------------------------------
# ITV Data Feed
# ------------------------------------------------------------
ITV_SFTP_HOST=""
ITV_SFTP_USER=""
ITV_SFTP_PASSWORD=""

# ------------------------------------------------------------
# AWS S3 (almacenamiento de informes y documentos)
# ------------------------------------------------------------
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_REPORTS="vehiq-reports"
S3_BUCKET_ASSETS="vehiq-assets"

# ------------------------------------------------------------
# ML Model Service (valoraciones IA)
# ------------------------------------------------------------
ML_SERVICE_URL="http://localhost:8000"
ML_API_KEY=""

# ------------------------------------------------------------
# Sentry (seguimiento de errores)
# ------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------
# Analytics
# ------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"
